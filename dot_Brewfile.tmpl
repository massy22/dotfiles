# bun is provided by oven-sh/bun (not homebrew-core).
tap "oven-sh/bun"

# Core tools used by this dotfiles repository.
brew "chezmoi"
brew "gh"
brew "ghq"
brew "git-lfs"
brew "diff-so-fancy"
brew "shellcheck"
brew "zsh"

# Shell and development tools referenced from zsh, tmux, and editor configs.
brew "tmux"
brew "tig"
brew "neovim"
brew "jq"
brew "peco"
brew "ripgrep"
brew "bun"

# Optional language runtimes (install only what you use).
brew "pyenv"
brew "pyenv-virtualenv"
brew "fnm"
brew "go"

# Optional GUI tools managed here only when they are public and generic.
cask "ghostty"
cask "1password-cli"
