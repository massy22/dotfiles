" dein.vimで管理してるpluginを読み込む
source ~/.vimrc.bundle

"基本設定
source ~/.vimrc.basic
"StatusLine設定
source ~/.vimrc.statusline
"インデント設定
source ~/.vimrc.indent
"表示関連
source ~/.vimrc.apperance
"補完関連
source ~/.vimrc.completion
"Tags関連
source ~/.vimrc.tags
"検索関連
source ~/.vimrc.search
"移動関連
source ~/.vimrc.moving
"ウィンドウ関連
source ~/.vimrc.window
"Color関連
source ~/.vimrc.colors
"編集関連
source ~/.vimrc.editing
"エンコーディング関連
source ~/.vimrc.encoding
"その他
source ~/.vimrc.misc
"プラグインに依存するアレ
source ~/.vimrc.plugins_setting

"Vimでgitのログをきれいに表示する - derisの日記
