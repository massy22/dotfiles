" Vim-specific settings (shared settings are in ~/.config/nvim/shared.rc.vim)

let mapleader = ","

source ~/.config/nvim/shared.rc.vim

set modelines=0
set nobackup
set showcmd
set showmode
set laststatus=2
set ruler
set mouse=a

command! Ev edit $MYVIMRC
command! Rv source $MYVIMRC

silent! colorscheme default

highlight DiffAdd    cterm=bold ctermfg=10 ctermbg=22
highlight DiffDelete cterm=bold ctermfg=10 ctermbg=52
highlight DiffChange cterm=bold ctermfg=10 ctermbg=17
highlight DiffText   cterm=bold ctermfg=10 ctermbg=21

"-------------------------------------------------------------------------------
" Search
"-------------------------------------------------------------------------------
nnoremap <silent> <Esc><Esc> :nohlsearch<CR><Esc>
vnoremap <silent> // y/<C-R>=escape(@", '\\/.*$^~[]')<CR><CR>
vnoremap /r "xy:%s/<C-R>=escape(@x, '\\/.*$^~[]')<CR>//gc<Left><Left><Left>
nnoremap <expr> s* ':%substitute/\<' . expand('<cword>') . '\>/'

function! s:keeppatterns(cmd)
  let old = @/
  try
    execute a:cmd
    call histdel("/", -1)
  catch
    echohl ErrorMsg
    echo v:exception
    echohl NONE
  finally
    let @/ = old
  endtry
endfunction
command! -complete=command -nargs=* Keeppatterns call s:keeppatterns(<q-args>)

"-------------------------------------------------------------------------------
" Editing
"-------------------------------------------------------------------------------
inoremap jj <Esc>
inoremap <C-e> <End>
inoremap <C-a> <Home>
inoremap <C-u> <C-g>u<C-u>
inoremap <C-w> <C-g>u<C-w>

nnoremap y9 y$
nnoremap yd y$
nnoremap y0 y^
nnoremap yk y^
nnoremap <silent> <C-d> d0
nnoremap vy vawy
vnoremap v $h

command! Pt set paste!
nnoremap <Leader>j :%!python3 -m json.tool<CR>

augroup vimrc_editing
  autocmd!
  autocmd FileType qf nnoremap <buffer> q :cclose<CR>
  autocmd FileType qf nnoremap <buffer> <Esc> :cclose<CR>
augroup END

"-------------------------------------------------------------------------------
" Windows and buffers
"-------------------------------------------------------------------------------
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l

nnoremap <silent> <F2> :bprevious<CR>
nnoremap <silent> <F3> :bnext<CR>
nnoremap <silent> <F4> :bnext \| bdelete #<CR>
command! Bw bnext | bdelete #

nnoremap <silent> cw :call ToggleQfWindow()<CR>

"-------------------------------------------------------------------------------
" Encoding commands
"-------------------------------------------------------------------------------
set suffixes=.bak,~,.swp,.o,.info,.aux,.log,.dvi,.bbl,.blg,.brf,.cb,.ind,.idx,.ilg,.inx,.out,.toc

command! Cp932 edit ++enc=cp932
command! Eucjp edit ++enc=euc-jp
command! Iso2022jp edit ++enc=iso-2022-jp
command! Utf8 edit ++enc=utf-8
command! Jis Iso2022jp
command! Sjis Cp932

" ; starts command-line mode.
noremap ; :
