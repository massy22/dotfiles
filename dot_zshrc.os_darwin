typeset -U path

__path_prepend_if_dir() {
  [[ -d "$1" ]] && path=("$1" $path)
}

__path_append_if_dir() {
  [[ -d "$1" ]] && path=($path "$1")
}

__path_prepend_if_dir "/opt/local/sbin"
__path_prepend_if_dir "/opt/local/bin"
__path_prepend_if_dir "/usr/local/sbin"
__path_prepend_if_dir "/usr/local/bin"
__path_prepend_if_dir "/opt/homebrew/sbin"
__path_prepend_if_dir "/opt/homebrew/bin"
__path_append_if_dir "$HOME/bin"
__path_append_if_dir "/System/Library/PrivateFrameworks/Apple80211.framework/Versions/A/Resources"

# osx alias
alias pbc='pbcopy'

# Terminal Colorの設定
export CLICOLOR=1
export LSCOLORS=ExFxCxDxBxegedabagacad

# vim
if [[ -x /usr/local/Cellar/macvim-kaoriya/HEAD/MacVim.app/Contents/MacOS/Vim ]]; then
  alias vi8='env LANG=ja_JP.UTF-8 /usr/local/Cellar/macvim-kaoriya/HEAD/MacVim.app/Contents/MacOS/Vim "$@"'
  alias vim8='env LANG=ja_JP.UTF-8 /usr/local/Cellar/macvim-kaoriya/HEAD/MacVim.app/Contents/MacOS/Vim "$@"'
fi

## Java
if [[ -x /usr/libexec/java_home ]]; then
  java_home="$(/usr/libexec/java_home 2>/dev/null)"
  if [[ -n "$java_home" ]]; then
    export JAVA_HOME="$java_home"
    __path_prepend_if_dir "$JAVA_HOME/bin"
    export _JAVA_OPTIONS="-Dfile.encoding=UTF-8"
  fi
  unset java_home
fi

# haskell
__path_prepend_if_dir "$HOME/Library/Haskell/bin"

# scala
if [[ -d "$HOME/.svm/current/rt" ]]; then
  export SCALA_HOME="$HOME/.svm/current/rt"
  __path_prepend_if_dir "$SCALA_HOME/bin"
  export SCALA_DOC_HOME="$SCALA_HOME/../devel-docs/api/"
fi

# Ant
export ANT_VERSION=1.8.0
if [[ -d "$HOME/dev/Tools/apache-ant-${ANT_VERSION}" ]]; then
  export ANT_HOME="$HOME/dev/Tools/apache-ant-${ANT_VERSION}"
  export ANT_OPTS=-Xmx1g
  __path_prepend_if_dir "$ANT_HOME/bin"
fi

# Maven2
export MAVEN_VERSION=2.2.1
if [[ -d "$HOME/dev/Tools/apache-maven-${MAVEN_VERSION}" ]]; then
  export MAVEN_HOME="$HOME/dev/Tools/apache-maven-${MAVEN_VERSION}"
  export MAVEN_OPTS=-Xmx1024M
  __path_prepend_if_dir "$MAVEN_HOME/bin"
fi

# man path
[[ -d /usr/local/man ]] && MANPATH="/usr/local/man:${MANPATH:-}"
[[ -d /usr/local/info ]] && INFOPATH="/usr/local/info:${INFOPATH:-}"
export MANPATH INFOPATH

# Mysql
if [[ -d /usr/local/mysql ]]; then
  export MYSQL_HOME=/usr/local/mysql
  __path_prepend_if_dir "$MYSQL_HOME/bin"
fi

# Python
__path_prepend_if_dir "$HOME/.pyenv/bin"
if command -v pyenv >/dev/null 2>&1; then
  eval "$(pyenv init -)"
  if pyenv commands 2>/dev/null | command grep -qx 'virtualenv-init'; then
    eval "$(pyenv virtualenv-init -)"
  fi
fi

# Ruby
if [[ -z "$RBENV_ROOT" && -d /usr/local/var/rbenv ]]; then
  export RBENV_ROOT=/usr/local/var/rbenv
fi
if command -v rbenv >/dev/null 2>&1; then
  eval "$(rbenv init -)"
fi

if [[ -d /System/Library/Frameworks/Ruby.framework/Versions/1.8/usr/share/refe ]]; then
  export REFE_DATA_DIR=/System/Library/Frameworks/Ruby.framework/Versions/1.8/usr/share/refe
fi

# Go Lang
if command -v go >/dev/null 2>&1; then
  export CGO_ENABLED=1
  export GOPATH=${GOPATH:-$HOME}
  __path_append_if_dir "$(go env GOROOT 2>/dev/null)/bin"
  __path_append_if_dir "$GOPATH/bin"
fi

# node.js
if command -v fnm >/dev/null 2>&1; then
  eval "$(fnm env --use-on-cd)"
fi

# tmux
alias tma='tmux attach'
alias tml='tmux list-window'

# ec2
# export EC2_PRIVATE_KEY="$(/bin/ls "$HOME"/.ec2/pk-*.pem | /usr/bin/head -1)"
# export EC2_CERT="$(/bin/ls "$HOME"/.ec2/cert-*.pem | /usr/bin/head -1)"
# export EC2_HOME="/usr/local/Library/LinkedKegs/ec2-api-tools/jars"

__path_prepend_if_dir "/usr/local/opt/protobuf@2.6/bin"
__path_prepend_if_dir "/usr/local/opt/elasticsearch@6/bin"
# __path_prepend_if_dir "/usr/local/opt/elasticsearch/bin"

# openssl
# export PATH="/usr/local/opt/openssl@3/bin:$PATH"
# export LDFLAGS="-L/usr/local/opt/openssl@3/lib"
# export CPPFLAGS="-I/usr/local/opt/openssl@3/include"
# export PKG_CONFIG_PATH="/usr/local/opt/openssl@3/lib/pkgconfig"

# The next line updates PATH for the Google Cloud SDK.
if [[ -f "$HOME/google-cloud-sdk/path.zsh.inc" ]]; then . "$HOME/google-cloud-sdk/path.zsh.inc"; fi

# The next line enables shell command completion for gcloud.
if [[ -f "$HOME/google-cloud-sdk/completion.zsh.inc" ]]; then . "$HOME/google-cloud-sdk/completion.zsh.inc"; fi

export PATH
unfunction __path_prepend_if_dir __path_append_if_dir
