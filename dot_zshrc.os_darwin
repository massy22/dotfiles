typeset -U path

__path_prepend_if_dir() {
  [[ -d "$1" ]] && path=("$1" $path)
}

__path_append_if_dir() {
  [[ -d "$1" ]] && path=($path "$1")
}

__path_prepend_if_dir "/opt/local/sbin"
__path_prepend_if_dir "/opt/local/bin"
__path_prepend_if_dir "/usr/local/sbin"
__path_prepend_if_dir "/usr/local/bin"
__path_prepend_if_dir "/opt/homebrew/sbin"
__path_prepend_if_dir "/opt/homebrew/bin"
__path_append_if_dir "$HOME/bin"
__path_append_if_dir "/System/Library/PrivateFrameworks/Apple80211.framework/Versions/A/Resources"

# osx alias
alias pbc='pbcopy'

# Terminal Colorの設定
export CLICOLOR=1
export LSCOLORS=ExFxCxDxBxegedabagacad

## Java
if [[ -x /usr/libexec/java_home ]]; then
  java_home="$(/usr/libexec/java_home 2>/dev/null)"
  if [[ -n "$java_home" ]]; then
    export JAVA_HOME="$java_home"
    __path_prepend_if_dir "$JAVA_HOME/bin"
    export _JAVA_OPTIONS="-Dfile.encoding=UTF-8"
  fi
  unset java_home
fi

# man path
[[ -d /usr/local/man ]] && MANPATH="/usr/local/man:${MANPATH:-}"
[[ -d /usr/local/info ]] && INFOPATH="/usr/local/info:${INFOPATH:-}"
export MANPATH INFOPATH

# Python
__path_prepend_if_dir "$HOME/.pyenv/bin"
if command -v pyenv >/dev/null 2>&1; then
  eval "$(pyenv init -)"
  if pyenv commands 2>/dev/null | command grep -qx 'virtualenv-init'; then
    eval "$(pyenv virtualenv-init -)"
  fi
fi

# Go Lang
if command -v go >/dev/null 2>&1; then
  export CGO_ENABLED=1
  export GOPATH=${GOPATH:-$HOME}
  __path_append_if_dir "$(go env GOROOT 2>/dev/null)/bin"
  __path_append_if_dir "$GOPATH/bin"
fi

# node.js
if command -v fnm >/dev/null 2>&1; then
  eval "$(fnm env --use-on-cd)"
fi

# tmux
alias tma='tmux attach'
alias tml='tmux list-window'

# The next line updates PATH for the Google Cloud SDK.
if [[ -f "$HOME/google-cloud-sdk/path.zsh.inc" ]]; then . "$HOME/google-cloud-sdk/path.zsh.inc"; fi

# The next line enables shell command completion for gcloud.
if [[ -f "$HOME/google-cloud-sdk/completion.zsh.inc" ]]; then . "$HOME/google-cloud-sdk/completion.zsh.inc"; fi

export PATH
unfunction __path_prepend_if_dir __path_append_if_dir
