#!/bin/sh

## debug mode
# DEBUG="yes"
if [ "$DEBUG" = "yes" ]; then
    set -x
fi

#
# メモリ使用率(%)を求める
#   精度は小数点第1位までとする
#
calculate_used_mem_vm_stat() {
    VM_STAT=$(vm_stat)
    PAGE_SIZE=$(pagesize 2>/dev/null || sysctl -n hw.pagesize 2>/dev/null || echo 4096)
    PAGES_ACTIVE=$(echo "$VM_STAT" | awk '/Pages active/ {print $3}' | tr -d '.')
    PAGES_INACTIVE=$(echo "$VM_STAT" | awk '/Pages inactive/ {print $3}' | tr -d '.')
    PAGES_SPECULATIVE=$(echo "$VM_STAT" | awk '/Pages speculative/ {print $3}' | tr -d '.')
    PAGES_WIRED=$(echo "$VM_STAT" | awk '/Pages wired down/ {print $4}' | tr -d '.')
    PAGES_FREE=$(echo "$VM_STAT" | awk '/Pages free/ {print $3}' | tr -d '.')

    if [ -z "$PAGES_ACTIVE" ] || [ -z "$PAGES_INACTIVE" ] || [ -z "$PAGES_SPECULATIVE" ] || [ -z "$PAGES_WIRED" ] || [ -z "$PAGES_FREE" ]; then
        return 1
    fi

    FREE_MEM=$((PAGES_FREE + PAGES_SPECULATIVE))
    USED_MEM=$((PAGES_ACTIVE + PAGES_INACTIVE + PAGES_WIRED))
    ACTUAL_USED_MEM=$((PAGES_ACTIVE + PAGES_WIRED))
    TOTAL_MEM=$((FREE_MEM + USED_MEM))

    awk \
        -v used="$ACTUAL_USED_MEM" \
        -v total="$TOTAL_MEM" \
        -v page_size="$PAGE_SIZE" \
        'BEGIN {
            printf "%.1f%%(%.1fG/%.1fG)\n",
                used * 100 / total,
                used * page_size / 1024 / 1024 / 1024,
                total * page_size / 1024 / 1024 / 1024
        }'
}

calculate_used_mem_free() {
    free -m | awk '/^Mem:/ {
        used = $3
        total = $2
        printf "%.1f%%(%.1fG/%.1fG)\n", used * 100 / total, used / 1024, total / 1024
        found = 1
    }
    END { exit found ? 0 : 1 }'
}

if command -v vm_stat > /dev/null 2>&1; then
  calculate_used_mem_vm_stat
  exit $?
fi

if command -v free > /dev/null 2>&1; then
  calculate_used_mem_free
  exit $?
fi

exit 1

