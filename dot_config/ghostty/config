# Ghostty config — https://ghostty.org/docs/config

# テーマ
theme = tokyonight

# フォント
font-size = 13

# 背景
background-opacity = 0.85
background-blur-radius = 20

# 非アクティブペインを暗く
unfocused-split-opacity = 0.7

# カーソル
cursor-opacity = 0.8
cursor-color = ffffff

# ウィンドウ
window-padding-x = 4
window-padding-y = 4
window-padding-balance = true
window-save-state = always

# macOS 設定
macos-option-as-alt = left
