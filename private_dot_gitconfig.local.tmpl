# GitHub authentication is intentionally delegated to gh auth, SSH,
# or the platform credential helper. Do not embed PATs in remote URLs.
[url "git@github.com-personal:massy22/"]
  insteadOf = https://github.com/massy22/
  insteadOf = git@github.com:massy22/

{{- if eq .pcType "work" }}
{{- $op := onepasswordItemFields "Dotfiles Config" "Private" .onepasswordAccount }}
{{- $githubWorkOrg := $op.github_work_org.value }}
{{- $githubWorkAccount := $op.github_work_account.value }}
{{- $githubEnterpriseHost := $op.github_work_enterprise_host.value }}

[url "git@github.com-work:{{ $githubWorkOrg }}/"]
  insteadOf = https://github.com/{{ $githubWorkOrg }}/
  insteadOf = git@github.com:{{ $githubWorkOrg }}/

[url "git@github.com-work:{{ $githubWorkAccount }}/"]
  insteadOf = https://github.com/{{ $githubWorkAccount }}/
  insteadOf = git@github.com:{{ $githubWorkAccount }}/

{{- if $githubEnterpriseHost }}
[hub]
  host = {{ $githubEnterpriseHost }}
{{- end }}
{{- end }}
