# users generic .zshrc file for zsh(1)

[[ -f ~/.zsh/options.zsh ]] && source ~/.zsh/options.zsh
[[ -f ~/.zsh/path.zsh ]] && source ~/.zsh/path.zsh
[[ -f ~/.zsh/magic-abbrev.zsh ]] && source ~/.zsh/magic-abbrev.zsh
[[ -f ~/.zsh/trash.zsh ]] && source ~/.zsh/trash.zsh

## alias設定
#
[[ -f ~/.zsh/alias.zsh ]] && source ~/.zsh/alias.zsh

# OS-specific settings (macOS)
case "${OSTYPE}" in
darwin*)
  [[ -f ~/.zsh/os-darwin.zsh ]] && source ~/.zsh/os-darwin.zsh
  ;;
esac

# setting for peco.zsh
[[ -f ~/.zsh/peco.zsh ]] && source ~/.zsh/peco.zsh

## local固有設定
#
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

# Work-specific settings (Vertex AI, Claude Code, Gemini CLI, etc.)
# are generated into ~/.zshrc.local by chezmoi
