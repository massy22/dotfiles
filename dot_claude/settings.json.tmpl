{
  {{ if eq .pcType "work" }}"env": {{ onepasswordRead "op://Private/Dotfiles Config/claude_work_env" }},
  "otelHeadersHelper": "~/.claude/otel-headers-helper.sh",{{ end }}
  "permissions": {
    "allow": [
      "Bash(awk:*)",
      "Bash(bun run:*)",
      "Bash(cat:*)",
      "Bash(chmod:*)",
      "Bash(claude:*)",
      "Bash(corepack enable:*)",
      "Bash(diff:*)",
      "Bash(direnv exec:*)",
      "Bash(echo:*)",
      "Bash(export:*)",
      "Bash(find:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr comments:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh search:*)",
      "Bash(git add:*)",
      "Bash(git blame:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git merge-base:*)",
      "Bash(git remote:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show-ref:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(go build:*)",
      "Bash(go doc:*)",
      "Bash(go list:*)",
      "Bash(go mod:*)",
      "Bash(go test:*)",
      "Bash(go tool godotenv:*)",
      "Bash(go tool golangci-lint:*)",
      "Bash(godotenv:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(ls:*)",
      "Bash(make build:*)",
      "Bash(make lint:*)",
      "Bash(make test-dir:*)",
      "Bash(make test:*)",
      "Bash(mkdir:*)",
      "Bash(npm show:*)",
      "Bash(npx eslint:*)",
      "Bash(npx tsc:*)",
      "Bash(npx yarn:*)",
      "Bash(pyenv:*)",
      "Bash(shuf:*)",
      "Bash(sort:*)",
      "Bash(tail:*)",
      "Bash(test:*)",
      "Bash(textutil:*)",
      "Bash(touch:*)",
      "Bash(tree:*)",
      "Bash(unzip:*)",
      "Bash(wc:*)",
      "Bash(yarn build:*)",
      "Bash(yarn eslint:*)",
      "Bash(yarn lint:*)",
      "Bash(yarn lint:fix:*)",
      "Bash(yarn prettier:*)",
      "Bash(yarn tsc:*)",
      "Bash(yarn:*)",
      "mcp__claude_ai_Notion__notion-fetch",
      "mcp__claude_ai_Notion__notion-query-data-sources",
      "mcp__claude_ai_Notion__notion-search",
      "mcp__claude_ai_Google_Drive__search_files",
      "Skill(*)",
      "WebSearch",
      {{- /* WebFetch の信頼ドメイン許可リスト。評価順は deny→ask→allow で
           specificity は効かないため、bare な "WebFetch" を ask に残すと
           ここの allow が必ず負けて確認される。よって WebFetch は ask から
           外し、信頼ドメインだけここで無確認にする。非信頼ドメインはモード
           デフォルト(auto mode の classifier)任せ。
           domain:host は apex のみ、サブドメインは別途 *.host が必要
           (例: anthropic.com と *.anthropic.com の両方を列挙)。 */}}
      "WebFetch(domain:anthropic.com)",
      "WebFetch(domain:*.anthropic.com)",
      "WebFetch(domain:claude.com)",
      "WebFetch(domain:*.claude.com)",
      "WebFetch(domain:claude.ai)",
      "WebFetch(domain:*.claude.ai)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:*.github.com)",
      "WebFetch(domain:githubusercontent.com)",
      "WebFetch(domain:*.githubusercontent.com)",
      "WebFetch(domain:notion.so)",
      "WebFetch(domain:*.notion.so)",
      "WebFetch(domain:notion.com)",
      "WebFetch(domain:*.notion.com)",
      "WebFetch(domain:slack.com)",
      "WebFetch(domain:*.slack.com)",
      "WebFetch(domain:google.com)",
      "WebFetch(domain:*.google.com)",
      "WebFetch(domain:googleapis.com)",
      "WebFetch(domain:*.googleapis.com)",
      "WebFetch(domain:atlassian.com)",
      "WebFetch(domain:*.atlassian.com)",
      "WebFetch(domain:*.atlassian.net)",
      "WebFetch(domain:figma.com)",
      "WebFetch(domain:*.figma.com)"
    ],
    "deny": [
      "Bash(rm -rf:*)"
    ],
    {{- /* ask に載せないコマンドは allow にも入れない。記載がなければモードの
         デフォルト挙動に従うので、auto mode のときの自動承認に判断を委ねる。

         前提: auto mode の classifier が第2層として rm -rf 相当・main への
         push・データ持ち出し等を実行直前にブロックする。よって ask は
         「classifier が既に守る危険物」ではなく「正当だが一拍置きたいもの」に絞る。

         ask から意図的に外したもの:
           - python / python3 / bash: 任意コード実行だが classifier がラッパーを
             透視して中の実コマンドを評価するため、同程度のリスクに収まる
           - git mv: 追跡済みリネームで git により可逆
           - open: ファイル/URL を既定アプリで開くだけで状態を変えない
           - xargs: 単独では無害なパイプ補助
         ask に残すもの (外向き・破壊的・サプライチェーン): curl, gh api,
         gh pr create/edit, git push/checkout/clean/reset/rebase, go get,
         mv(既存ファイル上書きの恐れ), rm, osascript。
         WebFetch は bare では ask に入れない。ask は allow より優先され
         specificity も効かないので、bare WebFetch を ask に置くと上の信頼
         ドメイン allow が死ぬため。非信頼ドメインはモードデフォルト任せ。 */}}
    "ask": [
      "Bash(curl:*)",
      "Bash(gh api:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(git checkout:*)",
      "Bash(git clean:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(go get:*)",
      "Bash(mv:*)",
      "Bash(osascript:*)",
      "Bash(rm:*)"
    ]
  },
  "model": "opusplan",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "language": "日本語",
  "skipWorkflowUsageWarning": true,
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "voiceEnabled": true
}
