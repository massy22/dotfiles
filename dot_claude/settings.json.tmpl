{
  {{ if eq .pcType "work" }}"env": {{ onepasswordRead "op://Private/Dotfiles Config/claude_work_env" }},{{ end }}
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(chmod:*)",
      "Bash(claude:*)",
      "Bash(diff:*)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(git add:*)",
      "Bash(git blame:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(ls:*)",
      "Bash(make build:*)",
      "Bash(mkdir:*)",
      "Bash(npm show:*)",
      "Bash(shuf:*)",
      "Bash(tail:*)",
      "Bash(test:*)",
      "Bash(touch:*)",
      "Bash(tree:*)",
      "Bash(unzip:*)",
      "Bash(wc:*)",
      "Bash(yarn build:*)",
      "Bash(yarn lint:*)",
      "Bash(yarn lint:fix:*)",
      "WebSearch"
    ],
    "deny": [
      "Bash(rm -rf:*)"
    ],
    "ask": [
      "Bash(curl:*)",
      "WebFetch",
      "Bash(gh pr create:*)",
      "Bash(git checkout:*)",
      "Bash(git clean:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(mv:*)",
      "Bash(osascript:*)",
      "Bash(xargs:*)"
    ]
  },
  "model": "opusplan",
  "statusLine": {
    "type": "command",
    "command": "bun x ccusage statusline"
  },
  "enabledPlugins": {
    "code-simplifier@claude-plugins-official": true{{ if eq .pcType "work" }},
    "{{ onepasswordRead "op://Private/Dotfiles Config/claude_work_plugin" }}": true{{ end }}
  },
  "alwaysThinkingEnabled": true,
  "language": "日本語"
}
