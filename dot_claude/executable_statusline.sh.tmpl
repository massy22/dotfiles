#!/bin/bash
# Claude Code status line: BQ cost by model + session info
set -o pipefail

input=$(cat)

# --- Built-in session info ---
MODEL=$(echo "$input" | jq -r '.model.display_name // .model.id // "unknown"')
HAS_RATE_LIMITS=$(echo "$input" | jq -r 'if .rate_limits then "true" else "false" end')
TOTAL_INPUT=$(echo "$input" | jq -r '.context_window.total_input_tokens // 0')
TOTAL_OUTPUT=$(echo "$input" | jq -r '.context_window.total_output_tokens // 0')
USED_PCT=$(echo "$input" | jq -r '.context_window.used_percentage // 0' | cut -d. -f1)
SESSION_COST=$(echo "$input" | jq -r '.cost.total_cost_usd // 0')

# --- Provider and plan ---
# The status line JSON carries neither, so both are derived here.
#
# Provider: the same env vars in the same order as Claude Code's own resolver,
# with its truthiness test too (only 1/true/yes/on count), so
# CLAUDE_CODE_USE_VERTEX=0 reads as off instead of as Vertex.
#
# Plan: ~/.claude.json .oauthAccount is the only local source. organizationType
# names the plan and userRateLimitTier the size of the 5h/weekly windows, which
# is what actually differs between two seats on the same plan.
env_on() {
  case "$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')" in
  1 | true | yes | on) return 0 ;;
  *) return 1 ;;
  esac
}

PROVIDER="firstParty"
PROVIDER_LABEL=""
PROVIDER_REGION=""
if env_on "${CLAUDE_CODE_USE_BEDROCK:-}"; then
  PROVIDER="bedrock"
  PROVIDER_LABEL="Amazon Bedrock"
  PROVIDER_REGION="${AWS_REGION:-${AWS_DEFAULT_REGION:-}}"
elif env_on "${CLAUDE_CODE_USE_FOUNDRY:-}"; then
  PROVIDER="foundry"
  PROVIDER_LABEL="Microsoft Foundry"
elif env_on "${CLAUDE_CODE_USE_ANTHROPIC_AWS:-}"; then
  PROVIDER="anthropicAws"
  PROVIDER_LABEL="Claude Platform on AWS"
  PROVIDER_REGION="${AWS_REGION:-${AWS_DEFAULT_REGION:-}}"
elif env_on "${CLAUDE_CODE_USE_ANTHROPIC_GOOGLE_CLOUD:-}"; then
  PROVIDER="anthropicGoogleCloud"
  PROVIDER_LABEL="Claude Platform on Google Cloud"
  PROVIDER_REGION="${ANTHROPIC_GOOGLE_CLOUD_LOCATION:-}"
elif env_on "${CLAUDE_CODE_USE_MANTLE:-}"; then
  PROVIDER="mantle"
  PROVIDER_LABEL="Amazon Bedrock (Mantle)"
  PROVIDER_REGION="${AWS_REGION:-${AWS_DEFAULT_REGION:-}}"
elif env_on "${CLAUDE_CODE_USE_VERTEX:-}"; then
  PROVIDER="vertex"
  PROVIDER_LABEL="Vertex AI"
  # Claude Code falls back to us-east5 when CLOUD_ML_REGION is unset.
  PROVIDER_REGION="${CLOUD_ML_REGION:-us-east5}"
fi

PLAN_NAME=""
PLAN_TIER=""
if [ -f "$HOME/.claude.json" ]; then
  ACCOUNT=$(jq -r '.oauthAccount // {} | "\(.organizationType // "")|\(.userRateLimitTier // "")"' "$HOME/.claude.json" 2>/dev/null)
  ORG_TYPE="${ACCOUNT%%|*}"
  RATE_TIER="${ACCOUNT##*|}"
  case "$ORG_TYPE" in
  claude_pro) PLAN_NAME="Pro" ;;
  claude_max) PLAN_NAME="Max" ;;
  claude_team) PLAN_NAME="Team" ;;
  claude_enterprise) PLAN_NAME="Enterprise" ;;
  esac
  case "$RATE_TIER" in
  "") ;;
  default_claude_max_5x) PLAN_TIER="Max 5x" ;;
  default_claude_max_20x) PLAN_TIER="Max 20x" ;;
  default_claude_zero) PLAN_TIER="枠なし" ;;
  # An unknown tier is worth showing raw; guessing at it would be worse.
  *) PLAN_TIER="${RATE_TIER#default_claude_}" ;;
  esac
  # A Max plan is named by its tier, so "Max · Max 20x" says it twice.
  if [ "$PLAN_NAME" = "Max" ] && [ -n "$PLAN_TIER" ]; then
    PLAN_NAME="$PLAN_TIER"
    PLAN_TIER=""
  fi
  [ "$PLAN_TIER" = "$PLAN_NAME" ] && PLAN_TIER=""
fi

# What this session is spending: a provider label off the env, or the plan.
# .rate_limits is the one authoritative "this is subscription quota" signal, so
# it outranks a stray API key in the env; it is absent until the first response
# though, which is what the account file covers.
BASE_HOST="${ANTHROPIC_BASE_URL:-}"
BASE_HOST="${BASE_HOST#*://}"
BASE_HOST="${BASE_HOST%%/*}"
BASE_HOST="${BASE_HOST##*@}"
BASE_HOST="${BASE_HOST%%:*}"
if [ "$PROVIDER" != "firstParty" ]; then
  PLAN="${PROVIDER_LABEL}${PROVIDER_REGION:+ · ${PROVIDER_REGION}}"
elif [ -n "$BASE_HOST" ] && [ "$BASE_HOST" != "api.anthropic.com" ]; then
  PLAN="API プロキシ · ${BASE_HOST}"
elif [ "$HAS_RATE_LIMITS" = "true" ]; then
  PLAN="${PLAN_NAME:-Claude}${PLAN_TIER:+ · ${PLAN_TIER}}"
elif [ -n "${ANTHROPIC_API_KEY:-}${ANTHROPIC_AUTH_TOKEN:-}" ]; then
  PLAN="API 従量"
elif [ -n "$PLAN_NAME" ]; then
  PLAN="${PLAN_NAME}${PLAN_TIER:+ · ${PLAN_TIER}}"
else
  PLAN="Claude"
fi

# BQ splits the usage export on is_claude_ai: subscription seats on one side,
# metered API usage on the other. Name each after what it actually is.
if [ -n "$PLAN_NAME" ]; then
  BQ_SUB_LABEL="${PLAN_NAME}${PLAN_TIER:+/${PLAN_TIER}} 枠"
else
  BQ_SUB_LABEL="サブスク枠"
fi
BQ_API_LABEL="Vertex AI 従量"

# Format token counts (K)
fmt_tokens() {
  local n=$1
  if [ "$n" -ge 1000 ]; then
    echo "$((n / 1000))k"
  else
    echo "$n"
  fi
}

IN_FMT=$(fmt_tokens "$TOTAL_INPUT")
OUT_FMT=$(fmt_tokens "$TOTAL_OUTPUT")
SESSION_COST_FMT=$(printf '$%.2f' "$SESSION_COST")

# Rate limits
RATE_5H_PCT=$(echo "$input" | jq -r '.rate_limits.five_hour.used_percentage // empty' 2>/dev/null)
RATE_7D_PCT=$(echo "$input" | jq -r '.rate_limits.seven_day.used_percentage // empty' 2>/dev/null)

# Colors
CYAN='\033[36m'
GREEN='\033[32m'
YELLOW='\033[33m'
RED='\033[31m'
BOLD='\033[1m'
DIM='\033[2m'
RESET='\033[0m'

# Ring meter: ○ ◔ ◑ ◕ ●
RINGS=('○' '◔' '◑' '◕' '●')

ring_gradient() {
  local pct=$1
  if [ "$pct" -lt 50 ]; then
    local r=$((pct * 5))
    printf '\033[38;2;%d;200;80m' "$r"
  else
    local g=$((200 - (pct - 50) * 4))
    [ "$g" -lt 0 ] && g=0
    printf '\033[38;2;255;%d;60m' "$g"
  fi
}

ring_fmt() {
  local label=$1 pct=$2
  local idx=$((pct / 25))
  [ "$idx" -gt 4 ] && idx=4
  local color
  color=$(ring_gradient "$pct")
  echo -e "${DIM}${label}${RESET} ${color}${RINGS[$idx]} ${pct}%${RESET}"
}

bar_fmt() {
  local label=$1 pct=$2
  local width=6
  local filled=$((pct * width / 100))
  [ "$filled" -gt "$width" ] && filled=$width
  local empty=$((width - filled))
  local color
  color=$(ring_gradient "$pct")
  local bar=""
  local i
  for ((i=0; i<filled; i++)); do bar="${bar}█"; done
  for ((i=0; i<empty; i++)); do bar="${bar}░"; done
  echo -e "${BOLD}${label}${RESET} ${color}${bar}${RESET} ${color}${pct}%${RESET}"
}

# Context bar color (for full mode labels)
if [ "$USED_PCT" -ge 90 ]; then BAR_COLOR="$RED"
elif [ "$USED_PCT" -ge 70 ]; then BAR_COLOR="$YELLOW"
else BAR_COLOR="$GREEN"; fi

# --- BQ cost config (secrets injected via 1Password at chezmoi apply time) ---
{{ if eq .pcType "work" -}}
BQ_PROJECT="{{ onepasswordRead "op://Private/Dotfiles Config/vertex_work_project_id" }}"
BQ_TABLE="{{ onepasswordRead "op://Private/Dotfiles Config/claude_work_bq_table" }}"
{{- else -}}
BQ_PROJECT=""
BQ_TABLE=""
{{- end }}

# --- BQ cost (cached, refresh every 5 min) ---
USER_EMAIL=$(gcloud config get-value account 2>/dev/null)
CACHE_FILE="/tmp/claude-statusline-bq-cost-$(whoami)"
CACHE_FILE_7D="/tmp/claude-statusline-bq-cost-7d-$(whoami)"
# Named per user rather than per PID on purpose. Claude Code aborts the
# previous status line run before starting the next one, so a run killed while
# bq is still answering never reaches its own cleanup, and a per-PID path would
# leave a file behind on every abort. One reused path cannot accumulate, and
# the worst a race between two sessions costs is a garbled reason string.
BQ_ERR_FILE="/tmp/claude-statusline-bq-err-$(whoami)"
CACHE_MAX_AGE=300
BQ_STATUS=""

cache_age() {
  [ -f "$1" ] || return 1
  echo $(($(date +%s) - $(stat -f %m "$1" 2>/dev/null || echo 0)))
}

cache_is_stale() {
  local age
  age=$(cache_age "$1") || return 0
  [ "$age" -gt "$CACHE_MAX_AGE" ]
}

fmt_age() {
  local s=$1
  if [ "$s" -lt 3600 ]; then
    echo "$((s / 60))分前"
  elif [ "$s" -lt 86400 ]; then
    echo "$((s / 3600))時間前"
  else
    echo "$((s / 86400))日前"
  fi
}

# Why the query failed is the useful part: an expired gcloud token is one
# command away from fixed, and dropping the BQ lines silently hid that.
bq_fail_reason() {
  case "$1" in
  *Reauthentication* | *"auth tokens"* | *"gcloud auth login"*) echo "gcloud 再認証が必要" ;;
  *"Access Denied"* | *"Permission denied"* | *"permission"*) echo "権限なし" ;;
  *"Not found"* | *"not found"*) echo "テーブルが見つからない" ;;
  *) echo "クエリ失敗" ;;
  esac
}

run_bq() {
  local dest=$1 rows=$2 sql=$3 out
  if out=$(bq query --project_id="${BQ_PROJECT}" --use_legacy_sql=false \
    --format=json --max_rows="$rows" "$sql" 2>"$BQ_ERR_FILE") && [ -n "$out" ]; then
    printf '%s\n' "$out" >"$dest"
    return 0
  fi
  if [ -z "$BQ_STATUS" ]; then
    BQ_STATUS=$(bq_fail_reason "$(cat "$BQ_ERR_FILE" 2>/dev/null)")
  fi
  return 1
}

if [ -n "$BQ_PROJECT" ]; then
  if ! command -v bq >/dev/null 2>&1; then
    BQ_STATUS="bq コマンドがない"
  else
    if cache_is_stale "$CACHE_FILE"; then
      run_bq "$CACHE_FILE" 40 "
        SELECT is_claude_ai, model, cost, total_input_tokens, total_output_tokens
        FROM \`${BQ_TABLE}\`
        WHERE user_email = '${USER_EMAIL}'
        AND usage_date = CURRENT_DATE('Asia/Tokyo')
        ORDER BY is_claude_ai, cost DESC
      " || true
    fi
    if cache_is_stale "$CACHE_FILE_7D"; then
      run_bq "$CACHE_FILE_7D" 2 "
        SELECT is_claude_ai, ROUND(SUM(cost), 2) AS total_cost_7d
        FROM \`${BQ_TABLE}\`
        WHERE user_email = '${USER_EMAIL}'
        AND usage_date >= DATE_SUB(CURRENT_DATE('Asia/Tokyo'), INTERVAL 6 DAY)
        GROUP BY is_claude_ai
      " || true
    fi
  fi
  rm -f "$BQ_ERR_FILE"
fi

# The detail slot after the separator holds the per-model breakdown. An empty
# result set is not the same as a quiet day, so it says so there rather than
# leaving a separator with nothing behind it.
#
# Data that survived a failed refresh is still worth showing, but not without
# saying how old it is.
BQ_AGE_TAG=""
if [ -f "$CACHE_FILE" ]; then
  BQ_AGE=$(cache_age "$CACHE_FILE")
  if [ "$BQ_AGE" -gt "$CACHE_MAX_AGE" ]; then
    BQ_AGE_TAG=" ${DIM}⌛$(fmt_age "$BQ_AGE")${BQ_STATUS:+・${BQ_STATUS}}${RESET}"
  fi
fi

# --- Compact mode (env var: CLAUDE_STATUSLINE_COMPACT=1) ---
COMPACT=false
[ "${CLAUDE_STATUSLINE_COMPACT:-0}" = "1" ] && COMPACT=true

# --- Parse BQ data (needed for both modes) ---
VERTEX_DAILY=0; MAX_DAILY=0
VERTEX_LINE=""; MAX_LINE=""
if [ -f "$CACHE_FILE" ]; then
  while IFS= read -r row; do
    is_ai=$(echo "$row" | jq -r '.is_claude_ai')
    m=$(echo "$row" | jq -r '.model')
    c=$(echo "$row" | jq -r '.cost')
    it=$(echo "$row" | jq -r '.total_input_tokens')
    ot=$(echo "$row" | jq -r '.total_output_tokens')
    short_m=$(echo "$m" | sed 's/claude-//;s/-20[0-9]*//')
    it_fmt=$(fmt_tokens "$it")
    ot_fmt=$(fmt_tokens "$ot")
    detail="${short_m} ${YELLOW}\$${c}${RESET}(⬇ ${it_fmt} / ⬆ ${ot_fmt}) "
    if [ "$is_ai" = "true" ]; then
      MAX_DAILY=$(echo "$MAX_DAILY + $c" | bc 2>/dev/null || echo "$MAX_DAILY")
      MAX_LINE="${MAX_LINE}${detail}"
    else
      VERTEX_DAILY=$(echo "$VERTEX_DAILY + $c" | bc 2>/dev/null || echo "$VERTEX_DAILY")
      VERTEX_LINE="${VERTEX_LINE}${detail}"
    fi
  done < <(jq -c '.[]' "$CACHE_FILE" 2>/dev/null)
fi

VERTEX_FMT=$(printf '$%.2f' "$VERTEX_DAILY")
MAX_FMT=$(printf '$%.2f' "$MAX_DAILY")

# 7-day cost. Keep the numbers at 0 when the cache is missing so the
# comparisons below stay valid arithmetic.
VERTEX_7D=0; MAX_7D=0
VERTEX_7D_FMT=""; MAX_7D_FMT=""
if [ -f "$CACHE_FILE_7D" ]; then
  VERTEX_7D=$(jq -r '[.[] | select(.is_claude_ai == "false")] | .[0].total_cost_7d // 0' "$CACHE_FILE_7D" 2>/dev/null)
  MAX_7D=$(jq -r '[.[] | select(.is_claude_ai == "true")] | .[0].total_cost_7d // 0' "$CACHE_FILE_7D" 2>/dev/null)
  VERTEX_7D_FMT=$(printf '$%.2f' "$VERTEX_7D")
  MAX_7D_FMT=$(printf '$%.2f' "$MAX_7D")
fi

# 💎 is about today's subscription-side usage, not about what this session
# happens to be talking to, so both modes gate it on the same number.
HAS_SUB_USAGE=false
if [ "$(echo "$MAX_DAILY > 0" | bc 2>/dev/null)" = "1" ] ||
  [ "$(echo "$MAX_7D > 0" | bc 2>/dev/null)" = "1" ]; then
  HAS_SUB_USAGE=true
fi

# --- Output ---
if [ "$COMPACT" = true ]; then
  # Short version: ring meters + costs
  PARTS="${BOLD}${MODEL}${RESET}  $(ring_fmt ctx "$USED_PCT")"
  [ -n "$RATE_5H_PCT" ] && PARTS="${PARTS}  $(ring_fmt 5h "${RATE_5H_PCT%.*}")"
  [ -n "$RATE_7D_PCT" ] && PARTS="${PARTS}  $(ring_fmt 7d "${RATE_7D_PCT%.*}")"
  if [ -f "$CACHE_FILE" ]; then
    if [ "$HAS_SUB_USAGE" = true ]; then
      COST_PART="💎${YELLOW}${MAX_FMT}${RESET} ⛅${YELLOW}${VERTEX_FMT}${RESET}"
    else
      COST_PART="⛅${YELLOW}${VERTEX_FMT}${RESET}"
    fi
  elif [ -n "$BQ_PROJECT" ]; then
    COST_PART="⛅${DIM}--${RESET}"
  else
    COST_PART=""
  fi
  echo -e "${PARTS}  💰${YELLOW}${SESSION_COST_FMT}${RESET}${COST_PART:+  ${COST_PART}}"
else
  # Full version: 2-3 lines with details (original style)
  RATE_PART=""
  [ -n "$RATE_5H_PCT" ] && RATE_PART="${RATE_PART} │ ⏱ $(bar_fmt "5時間枠" "${RATE_5H_PCT%.*}")"
  [ -n "$RATE_7D_PCT" ] && RATE_PART="${RATE_PART} │ 📅 $(bar_fmt "週次枠" "${RATE_7D_PCT%.*}")"
  echo -e "🤖 ${CYAN}${MODEL}${RESET} (${PLAN}) │ 🧠 コンテキスト ${BAR_COLOR}${USED_PCT}%${RESET}${RATE_PART} │ ⬇ 入力 ${IN_FMT} ⬆ 出力 ${OUT_FMT} │ 💰 セッション ${YELLOW}${SESSION_COST_FMT}${RESET}"

  if [ -f "$CACHE_FILE" ]; then
    VERTEX_7D_PART=""
    [ -n "$VERTEX_7D_FMT" ] && VERTEX_7D_PART=" (過去7日間 ${YELLOW}${VERTEX_7D_FMT}${RESET})"
    echo -e "⛅ ${BQ_API_LABEL}${BQ_AGE_TAG} 本日 ${YELLOW}${VERTEX_FMT}${RESET}${VERTEX_7D_PART} │ ${VERTEX_LINE:-${DIM}該当行なし${RESET}}"

    if [ "$HAS_SUB_USAGE" = true ]; then
      MAX_7D_PART=""
      [ -n "$MAX_7D_FMT" ] && MAX_7D_PART=" (過去7日間 ${YELLOW}${MAX_7D_FMT}${RESET})"
      echo -e "💎 ${BQ_SUB_LABEL} 本日 ${YELLOW}${MAX_FMT}${RESET}${MAX_7D_PART} │ ${MAX_LINE:-${DIM}該当行なし${RESET}}"
    fi
  elif [ -n "$BQ_PROJECT" ]; then
    echo -e "⛅ ${DIM}BQ 取得不可 (${BQ_STATUS:-理由不明})${RESET}"
  fi
fi
