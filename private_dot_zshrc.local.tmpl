{{ if eq .pcType "work" -}}
# Work-specific settings (generated by chezmoi)

{{- $workToolsPath := onepasswordRead "op://Private/Dotfiles Config/tools_work_path" .onepasswordAccount }}
{{- $workMigrationDir := onepasswordRead "op://Private/Dotfiles Config/migration_work_dir" .onepasswordAccount }}
{{- $workSpannerMigrationDir := onepasswordRead "op://Private/Dotfiles Config/spanner_work_migration_dir" .onepasswordAccount }}
{{- $vertexWorkProjectId := onepasswordRead "op://Private/Dotfiles Config/vertex_work_project_id" .onepasswordAccount }}
{{- $githubWorkOrg := onepasswordRead "op://Private/Dotfiles Config/github_work_org" .onepasswordAccount }}

{{ if $workToolsPath -}}
# Work project tools
export PATH=$PATH:{{ $workToolsPath }}
{{ end -}}

{{ if $workMigrationDir -}}
export MIGRATION_DIR={{ $workMigrationDir }}
{{ end -}}

{{ if $workSpannerMigrationDir -}}
export SPANNER_MIGRATION_DIR={{ $workSpannerMigrationDir }}
{{ end -}}

{{ if $vertexWorkProjectId -}}
# Vertex AI / Gemini CLI
export ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-5
export CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD=1
export GOOGLE_GENAI_USE_VERTEXAI=true
export GOOGLE_CLOUD_LOCATION=us-east5
alias gemini='GOOGLE_CLOUD_PROJECT={{ $vertexWorkProjectId }} gemini'
{{ end -}}

{{ if $githubWorkOrg -}}
# Go private modules
export GOPRIVATE=github.com/{{ $githubWorkOrg }}
{{ end -}}
{{ else -}}
# Personal PC settings (generated by chezmoi)

# Antigravity
export PATH="$HOME/.antigravity/antigravity/bin:$PATH"
{{ end -}}
