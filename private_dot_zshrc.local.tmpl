{{ if eq .pcType "work" -}}
# Work-specific settings (generated by chezmoi)

{{- $op := onepasswordItemFields "Dotfiles Config" "Private" .onepasswordAccount }}
{{- $workToolsPath := $op.tools_work_path.value }}
{{- $workMigrationDir := $op.migration_work_dir.value }}
{{- $workSpannerMigrationDir := $op.spanner_work_migration_dir.value }}
{{- $vertexWorkProjectId := $op.vertex_work_project_id.value }}
{{- $githubWorkOrg := $op.github_work_org.value }}

{{ if $workToolsPath -}}
# Work project tools
export PATH=$PATH:{{ $workToolsPath }}
{{ end -}}

{{ if $workMigrationDir -}}
export MIGRATION_DIR={{ $workMigrationDir }}
{{ end -}}

{{ if $workSpannerMigrationDir -}}
export SPANNER_MIGRATION_DIR={{ $workSpannerMigrationDir }}
{{ end -}}

{{ if $vertexWorkProjectId -}}
# Vertex AI / Gemini CLI
export CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD=1
export GOOGLE_GENAI_USE_VERTEXAI=true
export GOOGLE_CLOUD_LOCATION=us-east5
alias gemini='GOOGLE_CLOUD_PROJECT={{ $vertexWorkProjectId }} gemini'
{{ end -}}

{{ if $githubWorkOrg -}}
# Go private modules
export GOPRIVATE=github.com/{{ $githubWorkOrg }}
{{ end -}}
{{ else -}}
# Personal PC settings (generated by chezmoi)

# Antigravity
export PATH="$HOME/.antigravity/antigravity/bin:$PATH"
{{ end -}}
