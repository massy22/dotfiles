{{ if eq .pcType "work" -}}
# Work-specific settings (generated by chezmoi)

{{- $workToolsPath := onepasswordRead "op://Private/Dotfiles Config/work_tools_path" }}
{{- $workMigrationDir := onepasswordRead "op://Private/Dotfiles Config/work_migration_dir" }}
{{- $workSpannerMigrationDir := onepasswordRead "op://Private/Dotfiles Config/work_spanner_migration_dir" }}
{{- $vertexWorkProjectId := onepasswordRead "op://Private/Dotfiles Config/vertex_work_project_id" }}
{{- $githubWorkOrg := onepasswordRead "op://Private/Dotfiles Config/github_work_org" }}

{{ if $workToolsPath -}}
# Work project tools
export PATH=$PATH:{{ $workToolsPath }}
{{ end -}}

{{ if $workMigrationDir -}}
export MIGRATION_DIR={{ $workMigrationDir }}
{{ end -}}

{{ if $workSpannerMigrationDir -}}
export SPANNER_MIGRATION_DIR={{ $workSpannerMigrationDir }}
{{ end -}}

{{ if $vertexWorkProjectId -}}
# Vertex AI / Claude Code / Gemini CLI
export ANTHROPIC_VERTEX_PROJECT_ID={{ $vertexWorkProjectId }}
export CLAUDE_CODE_USE_VERTEX=1
export CLOUD_ML_REGION=us-east5
export GOOGLE_GENAI_USE_VERTEXAI=true
export GOOGLE_CLOUD_LOCATION=us-east5
alias gemini='GOOGLE_CLOUD_PROJECT={{ $vertexWorkProjectId }} gemini'
{{ end -}}

{{ if $githubWorkOrg -}}
# Go private modules
export GOPRIVATE=github.com/{{ $githubWorkOrg }}
{{ end -}}
{{ else -}}
# Personal PC - no work-specific settings
{{ end -}}
